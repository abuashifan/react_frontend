# =============================================================================
# Production env contoh — Seaside Escape ERP Frontend (Vercel)
# =============================================================================
# Salin nilai ini ke Vercel → Project → Settings → Environment Variables
# (disarankan), ATAU buat file `.env.production` lokal saat build manual.
#
# VITE_API_BASE_URL = ORIGIN backend SAJA, TANPA akhiran `/api`.
# `src/services/http.ts` otomatis menambahkan `/api`, sehingga endpoint final:
#   https://api.finlite.my.id/api/auth/login
#
# Arsitektur: Opsi A (frontend Vercel + backend DigitalOcean, 2 domain + CORS).
# =============================================================================

VITE_API_BASE_URL=https://api.finlite.my.id
